@model List<NotificationListDto>
@{
    Layout = "_AdminLayout";
    ViewBag.Title = "Bildirim Ekranı";
}


@foreach (var item in Model)
{
    <div class="alert @(item.State == true ? " alert-light": " alert-primary")" role="alert">
        @item.Description   @{
            if (item.State == false)
            {
                <form asp-action="Update" asp-controller="Notification" asp-area="Admin" asp-route-id="@item.Id" method="post" class="d-inline">
                    <button type="submit" class="btn btn-link p-0 align-baseline">Okundu olarak işaretle</button>
                </form>
            }
        }
    </div>
}
