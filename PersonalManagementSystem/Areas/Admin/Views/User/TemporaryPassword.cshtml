@model TemporaryPasswordDto
@{
    Layout = "_AdminLayout";
    ViewBag.Title = "Geçici Şifre";
}

<div class="card mt-3">
    <div class="card-body">
        <h5 class="card-title">Geçici şifre oluşturuldu</h5>
        <p class="mb-2">Kullanıcı adı: <strong>@Model.Username</strong></p>
        <p class="mb-2">
            Geçici şifre:
            <code id="temporary-password" class="fs-5 user-select-all">@Model.TemporaryPassword</code>
        </p>
        <div class="alert alert-warning mb-3" role="alert">
            Bu şifre yalnızca bir kez gösterilir ve sistemde açık metin olarak saklanmaz.
            Kullanıcıya güvenli bir kanaldan iletin ve ilk girişte profil sayfasından değiştirmesini isteyin.
        </div>
        <a asp-action="List" asp-controller="User" asp-area="Admin" class="btn btn-primary">Kullanıcı listesine dön</a>
    </div>
</div>
