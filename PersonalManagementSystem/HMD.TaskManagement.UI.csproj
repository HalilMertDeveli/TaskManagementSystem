<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="8.0.21">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\HMD.TaskManagement.Application\HMD.TaskManagement.Application.csproj" />
    <ProjectReference Include="..\HMD.TaskManagement.Persistence\HMD.TaskManagement.Persistence.csproj" />
  </ItemGroup>

  <!-- Stops MSB3021 when the site (or IIS Express) still has bin\Debug DLLs loaded. Safe no-ops if nothing is running. -->
  <Target Name="StopRunningDevHostBeforeBuild" BeforeTargets="PrepareForBuild" Condition="'$(OS)' == 'Windows_NT' AND '$(DesignTimeBuild)' != 'true'">
    <Exec Command="cmd /c taskkill /F /IM HMD.TaskManagement.UI.exe /T 2&gt;nul" IgnoreExitCode="true" />
    <Exec Command="cmd /c taskkill /F /IM iisexpress.exe /T 2&gt;nul" IgnoreExitCode="true" />
  </Target>

</Project>
